# FocusGen Environment Variables Configuration
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret_key_for_jwt_session_signing

# Image Provider: "pollinations", "cloudflare", "gemini", or "none" (default: pollinations)
IMAGE_PROVIDER=pollinations

# Cloudflare Workers AI (Default Provider)
# Find Account ID in Cloudflare dashboard URL: dash.cloudflare.com/{ACCOUNT_ID}
# Create API Token with Workers AI permissions at dash.cloudflare.com/profile/api-tokens
# Default model if left empty is @cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=
CLOUDFLARE_FALLBACK_MODEL=

# Google Gemini / Imagen AI Image Model (Optional)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
IMAGE_MODEL=gemini-2.5-flash-image

# Keyless Licensed Web Search
# Built-in: Wikimedia Commons & Openverse require NO keys

# Focus Clarity Pipeline Mode: "level1" (post-process default) or "twopass" (optional Level 2)
FOCUS_MODE=level1

# (Optional) Google Sign-In Client ID: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
